# 爱快路由器
IKUAI_URL=http://10.0.0.1
IKUAI_USER=admin
IKUAI_PASS=改成你的爱快密码

# 同步配置
# 城市代码用逗号分隔，可在 https://github.com/metowolf/iplist/blob/master/docs/cncity.md 查
# 大连=210200 沈阳=210100 北京=110100 上海=310100 广州=440100 深圳=440300 杭州=330100
CITY_CODES=210200

# 每个IP分组最多包含多少条CIDR，超过会自动拆成 大连、大连2、大连3...
MAX_PER_GROUP=1000

# 分组名前缀，默认 "GEO_" 让爱快后台一眼看出是脚本生成的；留空则直接用城市名
GROUP_PREFIX=GEO_

# 定时同步 cron 表达式（Asia/Shanghai 时区），默认每月11号凌晨4点
SYNC_CRON=0 4 11 * *

# Web UI 暴露的宿主机端口
HOST_PORT=8765

LOG_LEVEL=INFO

# Web UI 鉴权 token：留空则不需要认证；设置后所有改配置/触发同步的接口都需要 Bearer
ADMIN_TOKEN=
